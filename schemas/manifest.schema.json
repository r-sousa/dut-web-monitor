{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dut/manifest.schema.json",
  "title": "DUT data manifest",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_version",
    "dataset_hash",
    "status",
    "changed_datasets",
    "record_counts",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dataset_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "dataset_hash": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "status": {
      "enum": [
        "valid",
        "partial"
      ]
    },
    "changed_datasets": {
      "type": "array",
      "items": {
        "enum": [
          "calls",
          "events",
          "publications",
          "webinars",
          "newsletters"
        ]
      }
    },
    "record_counts": {
      "type": "object"
    },
    "files": {
      "type": "object"
    },
    "errors": {
      "type": "array"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
