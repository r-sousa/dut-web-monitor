{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DUT publication record",
  "type": "object",
  "required": ["external_id", "content_type", "title", "category", "document_url", "source_status", "content_hash"],
  "properties": {
    "external_id": {"type": "string"},
    "content_type": {"const": "publication"},
    "title": {"type": "string"},
    "category": {"type": "string"},
    "document_url": {"type": "string", "format": "uri"},
    "source_status": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^sha256:"}
  }
}
